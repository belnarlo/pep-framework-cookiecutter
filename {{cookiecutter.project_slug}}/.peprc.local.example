# PEP Framework — personal settings (copy to .peprc.local and customise)
# This file is an example. .peprc.local is gitignored so changes stay local to you.

# Your name, used as author in PEP/BLOG templates
PEP_AUTHOR="Your Name"

# Editor to open when creating/editing PEPs and BLOGs
DEFAULT_EDITOR="vi"

# Automatically open the editor after creating a PEP/BLOG (true/false)
AUTO_OPEN_EDITOR="true"

# Path or URL to your local copy of the pep-framework-cookiecutter repo.
# Set this so "pep-tools.sh update-tools" works without --source each time.
# PEP_FRAMEWORK_SOURCE=""

# ask: point it at an OpenAI-compatible endpoint to have a model name the PEP.
# Only matched lines are sent. The key is read from the env var named here,
# never from this file.
# PEP_ASK_URL="https://llm.example.ts.net/v1"
# PEP_ASK_MODEL="local"
# PEP_ASK_KEY_ENV="LITELLM_MASTER_KEY"
