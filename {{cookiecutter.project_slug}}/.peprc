# PEP Framework Configuration — project-level settings (committed, shared with the team)
# Personal settings (author, editor, etc.) belong in .peprc.local (gitignored).

# Project information
PROJECT_NAME="{{cookiecutter.project_name}}"

# Directory configuration (relative to project root)
# Uncomment and modify if you want different paths
# PEP_DIR="docs/peps"
# BLOG_DIR="docs/blogs"
# TEMPLATE_DIR="docs/templates"

# Integration settings for monitoring
ZABBIX_HOST=""
GRAFANA_URL=""

# Git integration
# Set to true to require all commits reference a PEP (strict mode)
REQUIRE_PEP_REFERENCE=false

# Notification settings (optional)
SLACK_WEBHOOK=""
EMAIL_NOTIFICATIONS="false"

# Debug mode - set to true for verbose output
DEBUG="false"